{
  "rekordbox": {
    "process_name": "rekordbox.exe",
    "decks": 2,
    "offsets_dir": "data/offsets"
  },
  "library": {
    "master_db_path": null,
    "db_key": null,
    "copy_before_open": true
  },
  "session": {
    "bpm_tolerance_pct": 4.0,
    "allow_half_double_tempo": true,
    "camelot_enabled": true,
    "camelot_strictness": "moderate",
    "wildcard_probability": 0.15,
    "optimize_time_budget_s": 1.0,
    "variety": 0.5,
    "follow_list": true
  },
  "live": {
    "poll_interval_ms": 20,
    "reconnect_interval_s": 3,
    "position_jump_tolerance_s": 0.25,
    "max_consecutive_read_errors": 50,
    "load_debounce_ms": 300,
    "empty_deck_without_bpm": true
  },
  "mixer": {
    "crossfader_enabled": false,
    "crossfader_assign": {
      "1": "A",
      "2": "B",
      "3": "A",
      "4": "B"
    }
  },
  "detection": {
    "fader_zero_threshold": 0.05,
    "preview_touch_max_ms": 1500,
    "transition_stable_s": 4,
    "cut_max_beats": 1,
    "cut_group_gap_beats": 2,
    "bass_swap_window_beats": 4,
    "eq_low_threshold": 0.3,
    "on_beat_tolerance_ms": 60,
    "bass_swap_bar_tolerance_beats": 0.5,
    "default_bpm": 120.0
  },
  "history": {
    "dir": "history"
  },
  "ui": {
    "always_on_top": true,
    "start_compact": false,
    "theme": "rekordbox"
  },
  "lights": {
    "enabled": false,
    "esp32_ip": "192.168.4.1",
    "esp32_port": 4210,
    "latency_compensation_ms": 0,
    "events_dir": "data/lights",
    "send_to_simulator": false,
    "simulator_port": 4211,
    "simulator_http_port": 8765,
    "simulator_leds": 60,
    "effects": {
      "color": {
        "color": "azul"
      },
      "pulse": {
        "color": "morado",
        "bpm": "live"
      },
      "breathe": {
        "color": "azul",
        "period_ms": 4000
      },
      "build": {
        "color": "blanco",
        "dur_ms": 8000
      },
      "flash": {
        "color": "blanco",
        "dur_ms": 200
      },
      "strobe": {
        "dur_ms": 1000,
        "hz": 12
      },
      "rainbow": {
        "dur_ms": 4000
      },
      "off": {}
    },
    "rules": {
      "intro": {
        "fx": "breathe",
        "params": {
          "color": "azul",
          "period_ms": 4000
        }
      },
      "groove": {
        "fx": "pulse",
        "params": {
          "color": "morado",
          "bpm": "live"
        }
      },
      "peak": {
        "fx": "pulse",
        "params": {
          "color": "naranja",
          "bpm": "live"
        }
      },
      "breakdown": {
        "fx": "breathe",
        "params": {
          "color": "azul",
          "period_ms": 6000
        }
      },
      "buildup": {
        "fx": "build",
        "params": {
          "color": "blanco",
          "dur_ms": "until_next"
        }
      },
      "pre_drop": {
        "fx": "strobe",
        "params": {
          "dur_ms": "until_next",
          "hz": 16
        }
      },
      "drop_hit": {
        "fx": "flash",
        "params": {
          "color": "blanco",
          "dur_ms": 400
        }
      },
      "drop": {
        "fx": "pulse",
        "params": {
          "color": "rojo",
          "bpm": "live"
        }
      },
      "outro": {
        "fx": "breathe",
        "params": {
          "color": "azul",
          "period_ms": 6000
        }
      }
    }
  }
}
