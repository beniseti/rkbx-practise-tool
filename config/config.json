{
  "rekordbox": {
    "process_name": "rekordbox.exe",
    "decks": 2,
    "offsets_dir": "data/offsets"
  },
  "library": {
    "master_db_path": null,
    "db_key": null,
    "copy_before_open": true
  },
  "session": {
    "bpm_tolerance_pct": 4.0,
    "allow_half_double_tempo": true,
    "camelot_enabled": true,
    "camelot_strictness": "moderate",
    "wildcard_probability": 0.15,
    "optimize_time_budget_s": 1.0,
    "variety": 0.5,
    "follow_list": true
  },
  "live": {
    "poll_interval_ms": 20,
    "reconnect_interval_s": 3,
    "position_jump_tolerance_s": 0.25,
    "max_consecutive_read_errors": 50,
    "load_debounce_ms": 300,
    "empty_deck_without_bpm": true
  },
  "mixer": {
    "crossfader_enabled": false,
    "crossfader_assign": {
      "1": "A",
      "2": "B",
      "3": "A",
      "4": "B"
    }
  },
  "detection": {
    "fader_zero_threshold": 0.05,
    "preview_touch_max_ms": 1500,
    "transition_stable_s": 4,
    "cut_max_beats": 1,
    "cut_group_gap_beats": 2,
    "bass_swap_window_beats": 4,
    "eq_low_threshold": 0.3,
    "on_beat_tolerance_ms": 60,
    "bass_swap_bar_tolerance_beats": 0.5,
    "default_bpm": 120.0
  },
  "history": {
    "dir": "history"
  },
  "audio": {
    "enabled": true,
    "device": null,
    "loopback": true,
    "sample_rate": 44100,
    "channels": 2,
    "format": "flac",
    "block_ms": 100,
    "peaks_per_s": 20,
    "auto_stop_silence_s": 300,
    "silence_threshold_db": -50,
    "review_http_port": 8766
  },
  "ui": {
    "always_on_top": true,
    "start_compact": false,
    "theme": "material",
    "language": "es",
    "module": "all",
    "light_view": false
  },
  "lights": {
    "enabled": false,
    "esp32_ip": [
      "rkbx-luces.local",
      "192.168.4.1"
    ],
    "esp32_port": 4210,
    "latency_compensation_ms": 0,
    "events_dir": "data/lights",
    "send_to_simulator": false,
    "simulator_port": 4211,
    "simulator_http_port": 8765,
    "effects": {
      "color": {
        "color": "azul"
      },
      "pulse": {
        "color": "morado",
        "bpm": "live"
      },
      "breathe": {
        "color": "azul",
        "period_ms": 4000
      },
      "build": {
        "color": "blanco",
        "dur_ms": 8000
      },
      "flash": {
        "color": "blanco",
        "dur_ms": 200
      },
      "strobe": {
        "dur_ms": 1000,
        "hz": 12
      },
      "rainbow": {
        "dur_ms": 4000
      },
      "alternate": {
        "color": "morado",
        "color2": "azul",
        "bpm": "live"
      },
      "wave": {
        "color": "azul",
        "color2": "morado",
        "bpm": "live",
        "beats": 4
      },
      "twinkle": {
        "color": "azul",
        "color2": "morado",
        "density": 0.15,
        "bpm": "live"
      },
      "chase": {
        "color": "naranja",
        "bpm": "live",
        "beats": 1
      },
      "off": {},
      "prebuild": {
        "color": "$secondary",
        "dur_ms": 16000
      }
    },
    "rules": {
      "intro": {
        "fx": "wave",
        "params": {
          "color": "$primary",
          "color2": "$secondary",
          "bpm": "live",
          "beats": 4
        }
      },
      "groove": {
        "fx": "alternate",
        "params": {
          "color": "$primary",
          "color2": "$secondary",
          "bpm": "live"
        }
      },
      "peak_soft": {
        "fx": "pulse",
        "params": {
          "color": "$secondary",
          "bpm": "live"
        }
      },
      "peak_medium": [
        {
          "fx": "alternate",
          "params": {
            "color": "$secondary",
            "color2": "$accent",
            "bpm": "live"
          }
        },
        {
          "fx": "wave",
          "params": {
            "color": "$secondary",
            "color2": "$primary",
            "bpm": "live",
            "beats": 2
          }
        }
      ],
      "peak_hard": [
        {
          "fx": "chase",
          "params": {
            "color": "$secondary",
            "bpm": "live",
            "beats": 1
          }
        },
        {
          "fx": "alternate",
          "params": {
            "color": "$accent",
            "color2": "$secondary",
            "bpm": "live"
          }
        }
      ],
      "breakdown": {
        "fx": "twinkle",
        "params": {
          "color": "$secondary",
          "color2": "$primary",
          "density": 0.15,
          "bpm": "live"
        }
      },
      "buildup": {
        "fx": "build",
        "params": {
          "color": "blanco",
          "dur_ms": "until_next"
        }
      },
      "pre_drop": {
        "fx": "strobe",
        "params": {
          "dur_ms": "until_next",
          "hz": 16
        }
      },
      "blackout": {
        "fx": "off",
        "params": {},
        "beats": 3
      },
      "drop_hit": {
        "fx": null,
        "params": {}
      },
      "drop_soft": [
        {
          "fx": "pulse",
          "params": {
            "color": "$primary",
            "bpm": "live"
          }
        },
        {
          "fx": "wave",
          "params": {
            "color": "$primary",
            "color2": "$accent",
            "bpm": "live",
            "beats": 2
          }
        }
      ],
      "drop_medium": [
        {
          "fx": "alternate",
          "params": {
            "color": "$primary",
            "color2": "$accent",
            "bpm": "live"
          }
        },
        {
          "fx": "chase",
          "params": {
            "color": "$primary",
            "bpm": "live",
            "beats": 1
          }
        }
      ],
      "drop_hard": [
        {
          "fx": "chase",
          "params": {
            "color": "$accent",
            "bpm": "live",
            "beats": 0.5
          }
        },
        {
          "fx": "alternate",
          "params": {
            "color": "$accent",
            "color2": "$primary",
            "bpm": "live"
          }
        },
        {
          "fx": "wave",
          "params": {
            "color": "$accent",
            "color2": "$primary",
            "bpm": "live",
            "beats": 1
          }
        }
      ],
      "outro": {
        "fx": "wave",
        "params": {
          "color": "$primary",
          "color2": "$secondary",
          "bpm": "live",
          "beats": 8
        }
      }
    },
    "layout": {
      "strips": [
        {
          "leds": 14,
          "segments": 3,
          "pin": 25
        },
        {
          "leds": 14,
          "segments": 3,
          "pin": 26
        },
        {
          "leds": 14,
          "segments": 3,
          "pin": 27
        }
      ]
    },
    "fallback": {
      "fx": "wave",
      "params": {
        "color": "$primary",
        "color2": "$secondary",
        "bpm": "live",
        "beats": 4
      }
    },
    "idle": {
      "fx": "twinkle",
      "params": {
        "color": "blanco",
        "color2": "azul",
        "density": 0.06
      }
    }
  }
}
